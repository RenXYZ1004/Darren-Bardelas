# Optional: set your production origin explicitly when you have a custom domain.
# Vercel builds can automatically use VERCEL_PROJECT_PRODUCTION_URL when
# its system environment variables are exposed.
VITE_SITE_URL=

# Paste the exact token returned by Google Search Console for HTML-tag verification.
# Leave blank until you start the verification flow in Search Console.
VITE_GOOGLE_SITE_VERIFICATION=

# Supabase project URL and publishable key. Safe for browser use only when
# Row Level Security is enabled and the provided SQL policies are applied.
# Older projects may use the legacy anon key in VITE_SUPABASE_ANON_KEY instead.
# NEVER put a service_role/secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
